# Applicant portal (Next.js)
DATABASE_URL=mysql://majuu_portal:majuu_portal_secret@majuu-portal-db:3306/majuu_portal
UPLOAD_ROOT=/app/storage/uploads
NEXT_PUBLIC_APP_URL=http://localhost:8085

# MSEA business registration lookup
MSEA_API_URL=https://msea.ecitizen.go.ke/api/businesses
MSEA_USERNAME=wezesha
# SMS (guarantor OTP consent — Ebis Cloud, same provider as loans.uwezo.go.ke)
# Primary vars (used by web/lib/sms/sms.service.ts):
SMS_API_URL=https://sms.ebisclouderp.com/api/sms/sendsms
SMS_API_KEY=
SMS_SHORTCODE=Uwezo Fund
SMS_SERVICE_ID=0
# Optional aliases (loans portal naming — used as fallback if SMS_* unset):
# EBISCLOUD_SMS_API_URL=
# EBISCLOUD_SMS_API_KEY=
# EBISCLOUD_SMS_SHORTCODE=
# EBISCLOUD_SMS_SERVICE_ID=0
