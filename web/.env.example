# Applicant portal (Next.js)
DATABASE_URL=mysql://majuu_portal:majuu_portal_secret@majuu-portal-db:3306/majuu_portal
UPLOAD_ROOT=/app/storage/uploads
NEXT_PUBLIC_APP_URL=http://localhost:8085
APP_URL=http://localhost:8085

# Auth — JWT session tokens
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_REFRESH_SECRET=change-me-in-production-use-different-long-random-string

# eCitizen OAuth — authorize redirect_uri is registered on loans-admin
NEXT_PUBLIC_ADMIN_DOMAIN=https://loans-admin.uwezo.go.ke
# Server-side profile verification (Docker internal hostname + public Host header)
ADMIN_DOMAIN=https://loans-admin.uwezo.go.ke
ADMIN_INTERNAL_DOMAIN=http://uwezo-prod-admin
ECITIZEN_CLIENT_ID=
ECITIZEN_CLIENT_SECRET=
ECITIZEN_REDIRECT_URI=https://loans-admin.uwezo.go.ke/api/oauth/ecitizen
ECITIZEN_AUTH_URL=https://accounts.ecitizen.go.ke/oauth/authorize
ECITIZEN_TOKEN_URL=https://accounts.ecitizen.go.ke/oauth/access-token
ECITIZEN_USER_INFO_URL=https://accounts.ecitizen.go.ke/api/user-info

# Optional fallback for NEA agency lookup (local Agencies.csv is used first)
# NEXT_PUBLIC_AGENCY_API_URL=https://majuu.uwezo.go.ke:5002/search-agency

# MSEA business registration lookup
MSEA_API_URL=https://msea.ecitizen.go.ke/api/businesses
MSEA_USERNAME=wezesha
# Set MSEA_API_ENABLED=false to disable lookups (manual entry fallback is used).
# MSEA_API_ENABLED=true
# Optional: auto re-enable at midnight East Africa Time on this date (YYYY-MM-DD).
# MSEA_API_RESUME_DATE=2026-07-27
# SMS (guarantor OTP consent — Ebis Cloud, same provider as loans.uwezo.go.ke)
# Primary vars (used by web/lib/sms/sms.service.ts):
SMS_API_URL=https://sms.ebisclouderp.com/api/sms/sendsms
SMS_API_KEY=
SMS_SHORTCODE=Uwezo Fund
SMS_SERVICE_ID=0
# Optional aliases (loans portal naming — used as fallback if SMS_* unset):
# EBISCLOUD_SMS_API_URL=
# EBISCLOUD_SMS_API_KEY=
# EBISCLOUD_SMS_SHORTCODE=
# EBISCLOUD_SMS_SERVICE_ID=0

# PesaFlow (online invoices / repayment) — same var names as Core loans
# Prefer shared Uwezo Fund merchant if Treasury confirms; otherwise request Majuu credentials.
# Do not commit live secrets.
PESAFLOW_CHECKOUT_URL=
PESAFLOW_STATUS_URL=
PESAFLOW_API_CLIENT_ID=
PESAFLOW_SERVICE_ID=
PESAFLOW_HMAC_KEY=
PESAFLOW_HMAC_SECRET=
PESAFLOW_BILL_DESC=Uwezo Fund Wezesha Majuu Repayment
PESAFLOW_SEND_STK=false
# PESAFLOW_CALLBACK_SECRET=
# PESAFLOW_VERIFY_IPN_HASH=true
# Optional email for payment confirmations / reminders (portal)
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=noreply@uwezo.go.ke
# MAIL_FROM_NAME=Uwezo Fund Wezesha Majuu
