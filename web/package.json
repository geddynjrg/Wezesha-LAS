{
  "name": "majuu-portal-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && next dev --port 8085",
    "build": "prisma generate && next build",
    "postbuild": "cp -r public .next/standalone/web/public && cp -r .next/static .next/standalone/web/.next/static",
    "start": "PORT=8085 HOSTNAME=0.0.0.0 node .next/standalone/web/server.js",
    "start:next": "next start --port 8085",
    "lint": "next lint",
    "check-types": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.11.1",
    "@tabler/icons-react": "^3.17.0",
    "@workspace/ui": "workspace:*",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.4",
    "nanoid": "^5.1.5",
    "next": "15.3.2",
    "next-intl": "^4.1.0",
    "next-themes": "^0.4.6",
    "prisma": "6.11.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-signature-canvas": "1.1.0-alpha.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.13.17",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.2",
    "@types/react-signature-canvas": "^1.0.7",
    "@workspace/eslint-config": "workspace:^",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.5.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
