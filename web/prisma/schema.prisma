generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ApplicationPhase {
  GROUP
  INDIVIDUAL
}

enum ApplicationStatus {
  DRAFT
  GROUP_SUBMITTED
  INDIVIDUAL_IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum MemberLoanStatus {
  PENDING
  INDIVIDUAL_DRAFT
  INDIVIDUAL_SUBMITTED
  DISBURSED
}

enum GuarantorOtpStatus {
  PENDING
  SENT
  VERIFIED
  EXPIRED
}

model GroupApplication {
  id                   String            @id @default(cuid())
  acknowledgmentNumber String            @unique
  status               ApplicationStatus @default(DRAFT)
  phase                ApplicationPhase  @default(GROUP)
  progress             Int               @default(1)
  submittedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  groupData            GroupData?
  membership           GroupMembership?
  background           GroupBackground?
  bankAccount          GroupBankAccount?
  termsAccepted        Boolean           @default(false)
  members              GroupMember[]
  documents            ApplicationDocument[]

  @@index([status])
  @@index([acknowledgmentNumber])
  @@map("group_applications")
}

model GroupData {
  id                   String           @id @default(cuid())
  applicationId        String           @unique
  groupName              String
  registrationDate       DateTime?
  registrationNumber     String
  county                 String
  constituency           String
  ward                   String
  location               String?
  subLocation            String?
  clusterCategory        String?
  clusterCounty          String?
  clusterConstituency    String?
  destinationRegion      String?
  destinationCountry     String?
  agency                 String?
  agentNumber            String?
  localAgentName         String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  application            GroupApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("group_data")
}

model GroupMembership {
  id                   String           @id @default(cuid())
  applicationId        String           @unique
  totalMales           Int              @default(0)
  totalFemales         Int              @default(0)
  totalDisabledMales   Int              @default(0)
  totalDisabledFemales Int              @default(0)
  totalMembers         Int              @default(0)
  totalDisabled        Int              @default(0)
  application          GroupApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("group_membership")
}

model GroupBackground {
  id                 String           @id @default(cuid())
  applicationId      String           @unique
  purpose            String           @db.Text
  proposedActivities String           @db.Text
  application        GroupApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("group_background")
}

model GroupMember {
  id                    String           @id @default(cuid())
  applicationId         String
  name                  String
  idNo                  String
  gender                String?
  dob                   DateTime?
  passportNo            String?
  kraPin                String?
  educationLevel        String?
  poBox                 String?
  postalCode            String?
  town                  String?
  dependants            Int?
  mobile                String
  email                 String?
  subLocation           String?
  purpose               String?
  amount                Decimal?         @db.Decimal(12, 2)
  loanStatus            MemberLoanStatus @default(PENDING)
  signature             String?          @db.Text
  amountRepaid          Decimal?         @db.Decimal(12, 2)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  application           GroupApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  individualApplication IndividualApplication?

  @@unique([applicationId, idNo])
  @@index([applicationId])
  @@index([idNo])
  @@map("group_members")
}

model GroupBankAccount {
  id            String           @id @default(cuid())
  applicationId String           @unique
  bankName      String
  branchName    String?
  accountName   String
  accountNumber String
  application   GroupApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("group_bank_accounts")
}

model IndividualApplication {
  id                   String            @id @default(cuid())
  memberId             String            @unique
  acknowledgmentNumber String            @unique
  status               ApplicationStatus @default(DRAFT)
  progress             Int               @default(1)
  awardAmount          Decimal?          @db.Decimal(12, 2)
  submittedAt          DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  member               GroupMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  location             LocationData?
  guarantors           GuarantorData[]
  recruitment          RecruitmentData?
  budgetItems          BudgetItem[]
  bankAccount          IndividualBankAccount?
  creditHistory        CreditHistoryData?
  creditHistoryLoans   CreditHistoryLoan[]
  signature            SignatureData?
  tripartiteAccepted   Boolean           @default(false)
  documents            ApplicationDocument[]

  @@index([acknowledgmentNumber])
  @@map("individual_applications")
}

model LocationData {
  id            String                @id @default(cuid())
  applicationId String                @unique
  county        String
  constituency  String
  ward          String
  location      String?
  subLocation   String?
  application   IndividualApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("location_data")
}

model GuarantorData {
  id              String                @id @default(cuid())
  applicationId   String
  guarantorNumber Int
  name            String
  gender          String
  kraPin          String
  county          String
  constituency    String
  ward            String
  location        String?
  subLocation     String?
  nationalId      String
  phone           String
  otpCode         String?
  otpStatus       GuarantorOtpStatus    @default(PENDING)
  otpVerified     Boolean               @default(false)
  otpSentAt       DateTime?
  otpVerifiedAt   DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  application     IndividualApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, guarantorNumber])
  @@index([applicationId])
  @@map("guarantor_data")
}

model RecruitmentData {
  id                   String                @id @default(cuid())
  applicationId        String                @unique
  localAgentName       String?
  agentNumber          String?
  employerAbroad       String?
  recruiterCode        String?
  countryOfDestination String?
  natureOfWork         String?
  durationType         String?
  workDuration         String?
  currency             String?
  monthlyRemuneration  Decimal?              @db.Decimal(12, 2)
  convertedKesAmount   Decimal?              @db.Decimal(12, 2)
  application          IndividualApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("recruitment_data")
}

model BudgetItem {
  id            String                @id @default(cuid())
  applicationId String
  item          String
  cost          Decimal               @db.Decimal(12, 2)
  application   IndividualApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("budget_items")
}

model IndividualBankAccount {
  id            String                @id @default(cuid())
  applicationId String                @unique
  bankName      String
  branchName    String?
  accountName   String
  accountNumber String
  application   IndividualApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("individual_bank_accounts")
}

model CreditHistoryData {
  id             String                @id @default(cuid())
  applicationId  String                @unique
  hasLoanHistory Boolean               @default(false)
  application    IndividualApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("credit_history_data")
}

model CreditHistoryLoan {
  id                 String                @id @default(cuid())
  applicationId      String
  lender             String
  loanDate           DateTime?
  amount             Decimal               @db.Decimal(12, 2)
  duration           String
  monthlyInstallment Decimal               @db.Decimal(12, 2)
  outstandingAmount  Decimal               @db.Decimal(12, 2)
  application        IndividualApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("credit_history_loans")
}

model SignatureData {
  id              String                @id @default(cuid())
  applicationId   String                @unique
  digitalSignature String               @db.LongText
  application     IndividualApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("signature_data")
}

model ApplicationDocument {
  id                     String                 @id @default(cuid())
  groupApplicationId     String?
  individualApplicationId String?
  category               String
  fileName               String
  storagePath            String
  mimeType               String?
  uploadedAt             DateTime               @default(now())
  groupApplication       GroupApplication?      @relation(fields: [groupApplicationId], references: [id], onDelete: Cascade)
  individualApplication  IndividualApplication? @relation(fields: [individualApplicationId], references: [id], onDelete: Cascade)

  @@index([groupApplicationId])
  @@index([individualApplicationId])
  @@map("application_documents")
}

model County {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  constituencies Constituency[]

  @@map("counties")
}

model Constituency {
  id        Int     @id @default(autoincrement())
  name      String
  countyId  Int
  county    County  @relation(fields: [countyId], references: [id], onDelete: Cascade)
  wards     Ward[]

  @@unique([countyId, name])
  @@map("constituencies")
}

model Ward {
  id             Int          @id @default(autoincrement())
  name           String
  constituencyId Int
  constituency   Constituency @relation(fields: [constituencyId], references: [id], onDelete: Cascade)

  @@unique([constituencyId, name])
  @@map("wards")
}
